{
	"manifest_version": 3,
	"name": "AuditToPitch Pro",
	"version": "1.0.0",
	"description": "Audit websites. Generate pitches. Win more clients.",
	"icons": {
		"16": "Icons/icon16.png",
		"32": "Icons/icon32.png",
		"48": "Icons/icon48.png",
		"128": "Icons/icon128.png"
	},
	"permissions": ["activeTab", "storage"],
	"action": {
		"default_popup": "index.html",
		"default_icon": {
			"16": "Icons/icon16.png",
			"32": "Icons/icon32.png"
		}
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"externally_connectable": {
		"matches": ["http://localhost/*", "http://127.0.0.1/*", "https://audit-to-pitch-pro.vercel.app/*"]
	},
	"content_scripts": [
		{
			"matches": ["http://*/*", "https://*/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	]
}
